{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bezel Notes",
  "version": "0.1.1",
  "identifier": "com.celestialforge.bezellnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "/",
        "title": "Bezel Notes",
        "width": 340,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@64.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBRkJEQzZDNEQ5Q0I5ODIKUldTQ3VaeE5iTno3aXQrYjRPNlFEVWR5REhZYXRrYkJsK0VHZXF2Wlh3YXkrSDcxZUVUQzRYdlYK",
      "endpoints": [
        "https://github.com/celestial4919/bezel-notes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
